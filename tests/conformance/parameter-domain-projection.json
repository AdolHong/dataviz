{
  "family": "parameter-domain-projection",
  "cases": [
    {
      "id": "multi-parent-zero-false-stable-sort-all-available",
      "parameter": {
        "id": "stores",
        "type": "multiple_select",
        "value_type": "integer",
        "required": false,
        "initial": {"mode": "all"},
        "options": {
          "mode": "domain",
          "source": "stores",
          "value_field": "store_nbr",
          "label_field": "store_name",
          "sort_field": "display_order",
          "depends_on": {
            "bucket": {"field": "bucket"},
            "enabled": {"field": "enabled"}
          }
        }
      },
      "values": {"bucket": [0], "enabled": false},
      "rows": [
        {"bucket": 0, "enabled": false, "store_nbr": 10, "store_name": "Ten", "display_order": 2},
        {"bucket": 0, "enabled": false, "store_nbr": 2, "store_name": "Two", "display_order": 1},
        {"bucket": 1, "enabled": false, "store_nbr": 30, "store_name": "Thirty", "display_order": 3},
        {"bucket": 0, "enabled": true, "store_nbr": 40, "store_name": "Forty", "display_order": 4}
      ],
      "relation": {
        "parents": ["bucket", "enabled"],
        "rows": [
          {"signature": "2", "choice": {"value": 2, "label": "Two"}, "parents": {"bucket": "0", "enabled": "false"}},
          {"signature": "10", "choice": {"value": 10, "label": "Ten"}, "parents": {"bucket": "0", "enabled": "false"}},
          {"signature": "30", "choice": {"value": 30, "label": "Thirty"}, "parents": {"bucket": "1", "enabled": "false"}},
          {"signature": "40", "choice": {"value": 40, "label": "Forty"}, "parents": {"bucket": "0", "enabled": "true"}}
        ]
      },
      "raw_value": [10],
      "intent": "all_available",
      "expected_choices": [
        {"value": 2, "label": "Two"},
        {"value": 10, "label": "Ten"}
      ],
      "expected": {"value": [2, 10], "intent": "all_available"}
    },
    {
      "id": "stable-dedupe-and-partial-explicit-retention",
      "parameter": {
        "id": "items",
        "type": "multiple_select",
        "value_type": "text",
        "required": false,
        "initial": {"mode": "all"},
        "options": {
          "mode": "domain",
          "source": "products",
          "value_field": "item",
          "label_field": "item_name",
          "depends_on": {"category": {"field": "category"}}
        }
      },
      "values": {"category": "food"},
      "rows": [
        {"category": "food", "item": "A", "item_name": "Alpha"},
        {"category": "food", "item": "A", "item_name": "Alpha"},
        {"category": "food", "item": "B", "item_name": "Beta"},
        {"category": "beauty", "item": "C", "item_name": "Cream"}
      ],
      "relation": {
        "parents": ["category"],
        "rows": [
          {"signature": "\"A\"", "choice": {"value": "A", "label": "Alpha"}, "parents": {"category": "\"food\""}},
          {"signature": "\"A\"", "choice": {"value": "A", "label": "Alpha"}, "parents": {"category": "\"food\""}},
          {"signature": "\"B\"", "choice": {"value": "B", "label": "Beta"}, "parents": {"category": "\"food\""}},
          {"signature": "\"C\"", "choice": {"value": "C", "label": "Cream"}, "parents": {"category": "\"beauty\""}}
        ]
      },
      "raw_value": ["A", "outside"],
      "intent": "explicit",
      "expected_choices": [
        {"value": "A", "label": "Alpha"},
        {"value": "B", "label": "Beta"}
      ],
      "expected": {"value": ["A"], "intent": "explicit"}
    },
    {
      "id": "active-empty-parent-is-empty-not-query",
      "parameter": {
        "id": "cities",
        "type": "multiple_select",
        "value_type": "text",
        "required": false,
        "initial": {"mode": "empty"},
        "options": {
          "mode": "domain",
          "source": "locations",
          "value_field": "city",
          "depends_on": {"province": {"field": "province"}}
        }
      },
      "values": {"province": []},
      "rows": [
        {"province": "GD", "city": "SZ"}
      ],
      "relation": {
        "parents": ["province"],
        "rows": [
          {"signature": "\"SZ\"", "choice": {"value": "SZ", "label": "SZ"}, "parents": {"province": "\"GD\""}}
        ]
      },
      "raw_value": [],
      "intent": "explicit",
      "expected_choices": [],
      "expected": {"value": [], "intent": "explicit"}
    },
    {
      "id": "complete-invalidation-reapplies-initial-policy",
      "parameter": {
        "id": "cities",
        "type": "multiple_select",
        "value_type": "text",
        "required": false,
        "initial": {"mode": "all"},
        "options": {
          "mode": "domain",
          "source": "locations",
          "value_field": "city",
          "depends_on": {"province": {"field": "province"}}
        }
      },
      "values": {"province": ["HN"]},
      "rows": [
        {"province": "GD", "city": "SZ"},
        {"province": "HN", "city": "CS"}
      ],
      "relation": {
        "parents": ["province"],
        "rows": [
          {"signature": "\"SZ\"", "choice": {"value": "SZ", "label": "SZ"}, "parents": {"province": "\"GD\""}},
          {"signature": "\"CS\"", "choice": {"value": "CS", "label": "CS"}, "parents": {"province": "\"HN\""}}
        ]
      },
      "raw_value": ["SZ"],
      "intent": "explicit",
      "expected_choices": [
        {"value": "CS", "label": "CS"}
      ],
      "expected": {"value": ["CS"], "intent": "all_available"}
    },
    {
      "id": "metadata-conflict-is-stable-error",
      "parameter": {
        "id": "cities",
        "type": "multiple_select",
        "value_type": "text",
        "required": false,
        "initial": {"mode": "all"},
        "options": {
          "mode": "domain",
          "source": "locations",
          "value_field": "city",
          "label_field": "city_name",
          "depends_on": {"province": {"field": "province"}}
        }
      },
      "values": {"province": ["GD"]},
      "rows": [
        {"province": "GD", "city": "SZ", "city_name": "Shenzhen"},
        {"province": "GD", "city": "SZ", "city_name": "深圳"}
      ],
      "relation": {
        "parents": ["province"],
        "rows": [
          {"signature": "\"SZ\"", "choice": {"value": "SZ", "label": "Shenzhen"}, "parents": {"province": "\"GD\""}},
          {"signature": "\"SZ\"", "choice": {"value": "SZ", "label": "深圳"}, "parents": {"province": "\"GD\""}}
        ]
      },
      "raw_value": ["SZ"],
      "intent": "explicit",
      "expected_error_code": "parameter_domain_metadata_conflict"
    }
  ]
}
