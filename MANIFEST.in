include README.md
include dataviz-skill.md
include DESIGN.md
include plan.md
include CHANGELOG.md
include pyproject.toml
include setup.py
include tools/build_canvas_runtime.py
include tools/build_tanstack_table_runtime.py
include tools/tanstack_table_runtime_entry.js
include tools/sync_plotly_runtime.py
recursive-include docs *.md
graft src/dataviz

# Build metadata and tests are development inputs, not runtime package content.
prune src/dataviz/gallery/.dataviz
prune src/*.egg-info
prune tests
prune build
prune dist

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
global-exclude adapters.local.yaml
